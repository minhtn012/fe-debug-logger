{
  "manifest_version": 3,
  "name": "FE Feedback",
  "version": "0.3.0",
  "description": "Collect UI feedback on any page: pick elements, note bugs, export Markdown for Claude Code",
  "permissions": ["activeTab", "storage", "unlimitedStorage", "downloads", "offscreen", "tabs", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "capture/console-capture.js",
        "capture/user-action-capture.js",
        "capture/network-capture.js",
        "capture/component-state-capture.js",
        "capture/dom-snapshot-capture.js",
        "capture/page-freeze.js",
        "capture/annotation-capture.js",
        "capture/screenshot-capture.js",
        "feedback/fab-widget.js",
        "feedback/feedback-controller.js",
        "content-script-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
